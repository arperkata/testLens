{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["chrome", "vitest/globals"],
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx"]
}
