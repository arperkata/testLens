{
  "name": "testlens-hub",
  "version": "0.1.0",
  "description": "TestLens Hub: local ingestion server that turns Postman, Newman and HAR evidence into reviewed bug reports via the TestLens browser extension",
  "license": "MIT",
  "type": "module",
  "bin": {
    "testlens-hub": "./dist/testlens-hub.mjs"
  },
  "files": [
    "dist/testlens-hub.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["testlens", "postman", "newman", "har", "bug-report", "jira", "qa", "testing"],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "start": "node --import tsx ./src/server.ts",
    "dev": "node --import tsx --watch ./src/server.ts",
    "start:dist": "node ./dist/testlens-hub.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@testlens/schema": "*",
    "@testlens/redaction": "*",
    "@testlens/evidence-engine": "*",
    "@testlens/composer": "*",
    "@testlens/connectors-postman": "*",
    "@testlens/connectors-har": "*",
    "tsx": "^4.19.2"
  }
}
