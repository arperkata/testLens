{
  "name": "testlens",
  "version": "0.1.0",
  "private": true,
  "description": "TestLens (TL) — testing flight recorder and defect composer",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @testlens/extension",
    "build": "npm run build -w @testlens/extension",
    "zip": "npm run zip -w @testlens/extension",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
