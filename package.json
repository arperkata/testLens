{
  "name": "testlens",
  "version": "0.1.0",
  "private": true,
  "description": "TestLens (TL) — testing flight recorder and defect composer",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @testlens/extension",
    "build": "npm run build -w @testlens/extension",
    "zip": "npm run zip -w @testlens/extension",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e/run.mjs",
    "hub": "npm run start -w testlens-hub",
    "typecheck:hub": "tsc -p apps/hub/tsconfig.json --noEmit",
    "hub:build": "node apps/hub/build.mjs",
    "hub:start": "node apps/hub/dist/testlens-hub.mjs",
    "test:hub": "node apps/hub/build.mjs && node e2e/hub-bundle-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2"
  }
}
